# campwatch secrets — copy to .env and fill in. NEVER commit .env.

# Notification sinks (only the ones your config.yaml references need values)
HA_WEBHOOK_URL=
PUSHOVER_PUSH_TOKEN=
PUSHOVER_PUSH_USER=
NTFY_TOPIC=
# NTFY_SERVER=            # optional, defaults to https://ntfy.sh

# Authenticated sessions, keyed by the `session:` name used in config.yaml.
# `session: wa_primary` → SESSION_WA_PRIMARY_COOKIE / SESSION_WA_PRIMARY_CSRF.
# See README "Session capture & refresh" for how to obtain these.
SESSION_WA_PRIMARY_COOKIE=
SESSION_WA_PRIMARY_CSRF=

# Container timezone (compose passes this through)
TZ=America/Los_Angeles
